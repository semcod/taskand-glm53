#!/usr/bin/env node
// taskand — CLI. Transport: gateway (gdy /healthz odpowiada) albo lokalnie registry/core. Flaga --json: surowa odpowiedź.
import { spawnSync, execFileSync } from 'node:child_process';
import { readFileSync, realpathSync, existsSync } from 'node:fs';
import { randomBytes } from 'node:crypto';
import { dirname, join } from 'node:path';
import { fileURLToPath } from 'node:url';
import { deliver as runDelivery, renderDelivery } from '../operations/delivery.mjs';

const ROOT = dirname(dirname(realpathSync(fileURLToPath(import.meta.url))));
const REGISTRY = join(ROOT, 'generated/registry/core/taskand.dev/v1/bin.mjs');
const GATEWAY = process.env.TASKAND_GATEWAY || 'http://127.0.0.1:8077';
const argv = process.argv.slice(2);
let formatMode = 'txt';
const validFormats = ['json', 'yaml', 'yml', 'csv', 'txt', 'text', 'table'];
const filteredArgv = [];
for (let i = 0; i < argv.length; i++) {
  const a = argv[i];
  if (a === '--json') {
    formatMode = 'json';
  } else if (a.startsWith('--format=')) {
    const fmt = a.slice(9).toLowerCase();
    if (!validFormats.includes(fmt)) {
      console.error(`Nieobsługiwany format: ${fmt}. Dostępne: json, yaml, csv, txt, table`);
      process.exit(2);
    }
    formatMode = fmt;
  } else if (a === '--format') {
    const fmt = (argv[++i] || '').toLowerCase();
    if (!validFormats.includes(fmt)) {
      console.error(`Nieobsługiwany format: ${fmt || 'brak'}. Dostępne: json, yaml, csv, txt, table`);
      process.exit(2);
    }
    formatMode = fmt;
  } else {
    filteredArgv.push(a);
  }
}
const [cmd, ...args] = filteredArgv;

function loadEnv() {
  const file = join(ROOT, '.env');
  if (!existsSync(file)) return;
  for (const line of readFileSync(file, 'utf8').split('\n')) {
    const m = line.match(/^\s*([A-Z0-9_]+)\s*=\s*(.*?)\s*$/);
    if (m && process.env[m[1]] === undefined) process.env[m[1]] = m[2];
  }
}
loadEnv();
const credential = process.env.TASKAND_AUTH_TOKEN || 'taskand-admin-key';

async function gatewayUp() {
  try {
    return (await fetch(`${GATEWAY}/healthz`, { signal: AbortSignal.timeout(1000) })).ok;
  } catch {
    return false;
  }
}

async function post(path, body) {
  const r = await fetch(`${GATEWAY}${path}`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${credential}` },
    body: JSON.stringify(body)
  });
  return r.json();
}

function local(action, payload) {
  const audit = input => {
    const r = spawnSync('python3', [join(ROOT, 'gateway/context.py')], {
      input: JSON.stringify(input), encoding: 'utf8', timeout: 30000
    });
    if (r.status !== 0) throw new Error('CONTEXT_STORE_UNAVAILABLE');
    return JSON.parse(r.stdout);
  };
  let receipt;
  if (action === 'call') {
    try { receipt = audit({ action: 'begin', input: payload }); }
    catch { return { ok: false, error: 'CONTEXT_STORE_UNAVAILABLE', executed: false }; }
  }
  const r = spawnSync('node', [REGISTRY], { input: JSON.stringify({ action, ...payload }), encoding: 'utf8', maxBuffer: 64 * 1024 * 1024 });
  let result;
  try {
    result = JSON.parse(r.stdout);
  } catch {
    result = { ok: false, error: 'registry/core: brak poprawnej odpowiedzi', outcomeUnknown: true };
  }
  if (receipt) {
    try { return { ...result, ...audit({ action: 'finish', requestId: receipt.requestId, result }) }; }
    catch { return { ok: false, error: 'AUDIT_COMMIT_FAILED', outcomeUnknown: true, ...receipt }; }
  }
  return result;
}

// Akcja rejestru: przez gateway (z autoryzacją) lub lokalnie
async function reg(action, payload = {}) {
  if (!(await gatewayUp())) return local(action, payload);
  if (action === 'call') {
    const response = await post('/api/proc/call', { uri: payload.uri, data: payload.input, timeout: 900 });
    return response.result ? { ...response.result, requestId: response.requestId, promptRef: response.promptRef, answerRef: response.answerRef } : response;
  }
  const r = await post('/api/registry', { action, ...payload });
  return r.result || r;
}

async function chat(organism, message) {
  if (await gatewayUp()) return post('/api/chat', { message, organism });
  return local('call', { uri: 'proc://taskand.dev/dev/chat/v1', input: { message, organism }, timeout_ms: 900000 });
}

function toYaml(obj, indent = 0) {
  const pad = '  '.repeat(indent);
  if (obj === null || obj === undefined) return 'null\n';
  if (typeof obj === 'boolean' || typeof obj === 'number') return `${obj}\n`;
  if (typeof obj === 'string') {
    if (obj.includes('\n')) {
      return `|\n${obj.split('\n').map(l => pad + '  ' + l).join('\n')}\n`;
    }
    if (/^[a-zA-Z0-9_./:-]+$/.test(obj) && !/^(true|false|null|yes|no)$/i.test(obj)) return `${obj}\n`;
    return JSON.stringify(obj) + '\n';
  }
  if (Array.isArray(obj)) {
    if (obj.length === 0) return '[]\n';
    return obj.map(item => {
      if (item !== null && typeof item === 'object') {
        const itemYaml = toYaml(item, indent + 1).trimStart();
        return `${pad}- ${itemYaml}`;
      }
      return `${pad}- ${toYaml(item, 0)}`;
    }).join('');
  }
  if (typeof obj === 'object') {
    const keys = Object.keys(obj);
    if (keys.length === 0) return '{}\n';
    return keys.map(k => {
      const val = obj[k];
      if (val !== null && typeof val === 'object' && !(Array.isArray(val) && val.length === 0) && Object.keys(val).length > 0) {
        return `${pad}${k}:\n${toYaml(val, indent + 1)}`;
      }
      return `${pad}${k}: ${toYaml(val, indent + 1).trimStart()}`;
    }).join('');
  }
  return String(obj) + '\n';
}

function toCsv(obj) {
  const escapeCsv = v => {
    if (v === null || v === undefined) return '';
    const str = Array.isArray(v) ? v.join(';') : typeof v === 'object' ? JSON.stringify(v) : String(v);
    if (str.includes(',') || str.includes('"') || str.includes('\n')) {
      return `"${str.replace(/"/g, '""')}"`;
    }
    return str;
  };

  let rows = null;
  if (Array.isArray(obj)) {
    rows = obj;
  } else if (obj && typeof obj === 'object') {
    const arrayKeys = ['devices', 'projects', 'processes', 'peers', 'prescriptions', 'sensors', 'networks', 'interfaces', 'broken', 'report'];
    for (const k of arrayKeys) {
      if (Array.isArray(obj[k])) { rows = obj[k]; break; }
      if (obj.data && Array.isArray(obj.data[k])) { rows = obj.data[k]; break; }
      if (obj.result && Array.isArray(obj.result[k])) { rows = obj.result[k]; break; }
    }
  }

  if (Array.isArray(rows) && rows.length > 0) {
    if (typeof rows[0] === 'object' && rows[0] !== null) {
      const headers = [...new Set(rows.flatMap(r => Object.keys(r)))];
      const lines = [headers.join(',')];
      for (const r of rows) {
        lines.push(headers.map(h => escapeCsv(r[h])).join(','));
      }
      return lines.join('\n');
    }
    return ['value', ...rows.map(r => escapeCsv(r))].join('\n');
  }

  if (obj && typeof obj === 'object') {
    const lines = ['key,value'];
    for (const [k, v] of Object.entries(obj)) {
      lines.push(`${escapeCsv(k)},${escapeCsv(v)}`);
    }
    return lines.join('\n');
  }

  return escapeCsv(obj);
}

const print = (out, human) => {
  if (formatMode === 'json') {
    console.log(JSON.stringify(out, null, 2));
  } else if (formatMode === 'yaml' || formatMode === 'yml') {
    console.log(toYaml(out).trimEnd());
  } else if (formatMode === 'csv') {
    console.log(toCsv(out));
  } else {
    console.log(human ? human(out) : (out?.reply || JSON.stringify(out, null, 2)));
  }
  process.exitCode = out?.ok === false ? 1 : 0;
};

// ── Powoływanie węzłów (occupy): replikacja operatorska przez SSH, nigdy autonomiczna ──
// Manifest = jedno źródło prawdy o plikach węzła; @secret pomijane bez --with-secrets.
function readManifest(withSecrets) {
  const paths = [];
  for (const line of readFileSync(join(ROOT, 'bin/bootstrap.manifest'), 'utf8').split('\n')) {
    const t = line.trim();
    if (!t || t.startsWith('#')) continue;
    if (t.startsWith('@secret ')) { if (withSecrets) paths.push(t.slice(8).trim()); }
    else paths.push(t);
  }
  return paths;
}

// Prawdopodobny adres LAN mastera (pomija mosty docker/libvirt) — podpowiedź do handshake; nadpisywalny --master
function localLanIp() {
  try {
    const ips = execFileSync('hostname', ['-I'], { encoding: 'utf8' }).trim().split(/\s+/);
    const bridge = /^(172\.(1[6-9]|2\d|3[01])\.|192\.168\.(122|144|192|208|240)\.|10\.(42|64|201|240|250)\.)/;
    return ips.find(ip => /^\d+\.\d+\.\d+\.\d+$/.test(ip) && !bridge.test(ip)) || ips[0] || 'MASTER_IP';
  } catch { return 'MASTER_IP'; }
}

async function waitHealthz(url, ms = 45000) {
  const t0 = Date.now();
  while (Date.now() - t0 < ms) {
    try {
      const r = await fetch(`${url}/healthz`, { signal: AbortSignal.timeout(2000) });
      if (r.ok) return await r.json();
    } catch { /* jeszcze nie wstał */ }
    await new Promise(r => setTimeout(r, 2000));
  }
  return null;
}

const COMMANDS = {
  // Twin needs the operator host's network inventory and user namespaces.
  // Explicit local transport also avoids mistaking a container's network for the host.
  async twin([action = 'run', id]) {
    if (action === 'web') {
      const input = /^https?:\/\//.test(id || '')
        ? { action: 'run', urls: [id], steps: [{ action: 'goto', url: id }, { action: 'assert', selector: 'body', visible: true }] }
        : JSON.parse(readFileSync(id, 'utf8'));
      return print(local('call', { uri: 'proc://taskand.dev/twin/web/v1', input, timeout_ms: 330000 }));
    }
    print(local('call', { uri: 'proc://taskand.dev/twin/environment/v1',
      input: { action, ...(action === 'status' ? { id } : { taskId: id, scan: { scope: 'lan' } }) }, timeout_ms: 180000 }));
  },
  async proc([uri, data = '{}']) {
    print(await reg('call', { uri, input: JSON.parse(data), timeout_ms: 900000 }));
  },
  async status() {
    const up = await gatewayUp();
    const d = await reg('call', { uri: 'proc://taskand.dev/doctor/diagnose/v1', input: {} });
    print(d, o => [`gateway: ${up ? GATEWAY : 'OFFLINE (tryb lokalny)'}`, ...(o.details || [o.error])].join('\n'));
  },
  async procs([organism]) {
    print(await reg('list', { organism }), o => (o.processes || []).map(p => `${p.status.padEnd(10)} ${p.uri}  ${p.desc}`).join('\n') || o.error);
  },
  async approve([uri]) {
    print(await reg('approve', { uri }), o => (o.ok ? `✓ ${uri} → active` : `✗ ${o.error}`));
  },
  async deprecate([uri]) {
    print(await reg('deprecate', { uri }), o => (o.ok ? `✓ ${uri} → deprecated` : `✗ ${o.error}`));
  },
  async verify() {
    print(await reg('verify'), o => (o.ok ? `✓ ${o.checked} pakietów zgodnych z bindingHash` : `✗ zmienione: ${(o.broken || []).join(', ') || o.error}`));
  },
  async pull([peer, token]) {
    print(await reg('pull', { peer, token }), o => (o.ok ? [`${o.remoteNode}: ${o.offered} oferowanych, ${o.imported} zaimportowanych (candidate)`, ...o.report.filter(r => r.result !== 'same').map(r => `  ${r.result} ${r.uri} ${r.reason || ''}`)].join('\n') : `✗ ${o.error}`));
  },
  async heal([flag]) {
    const out = await reg('call', { uri: 'proc://taskand.dev/doctor/heal/v1', input: { run: flag !== '--plan' } });
    print(out, o => o.reply || `✗ ${o.error}`);
  },
  async peers() {
    print(await reg('peers'), o => (o.peers?.length ? o.peers.map(p => `  ${p}`).join('\n') : 'Brak peerów (genome.yaml: peers).'));
  },
  async peer([verb, url]) {
    if (verb === 'add') return print(await reg('peer_add', { url }), o => (o.ok ? `✓ peer: ${(o.peers || []).join(', ')}` : `✗ ${o.error}`));
    if (verb === 'remove' || verb === 'rm') return print(await reg('peer_remove', { url }), o => (o.ok ? `✓ peer usunięty; pozostają: ${(o.peers || []).join(', ') || '—'}` : `✗ ${o.error}`));
    print({ ok: false, error: 'Użycie: taskand peer add|remove <http://host:8077>' });
  },
  async deliver(rawArgs) {
    print(runDelivery(rawArgs, { root: ROOT }), renderDelivery);
  },
  // Powołanie węzła na innym hoście: kopia plików przez SSH + docker compose + rejestracja peera.
  // OPERATORSKIE i jawne: domyślnie tylko plan (dry-run); realne działanie wymaga --run i dostępu SSH operatora.
  // Organizmy tego NIE uruchamiają — mogą jedynie zaproponować (doctor: PEER_DOWN → człowiek).
  async occupy(rawArgs) {
    const o = { run: false, withSecrets: false, dir: '/opt/taskand', master: null, token: null, port: 8077 };
    const pos = [];
    for (let i = 0; i < rawArgs.length; i++) {
      const a = rawArgs[i];
      if (a === '--run') o.run = true;
      else if (a === '--dry-run') o.run = false;
      else if (a === '--with-secrets') o.withSecrets = true;
      else if (a === '--dir') o.dir = rawArgs[++i];
      else if (a === '--master') o.master = rawArgs[++i];
      else if (a === '--token') o.token = rawArgs[++i];
      else if (a === '--port') o.port = Number(rawArgs[++i]) || 8077;
      else pos.push(a);
    }
    const m = (pos[0] || '').match(/^(?:([\w.-]+)@)?([\w.-]+)(?::(\d+))?$/);
    if (!m) return print({ ok: false, error: 'Użycie: taskand occupy <user@host[:ssh_port]> [--dir /opt/taskand] [--with-secrets] [--master http://ip:8077] [--token TOKEN] [--run]' });
    const [, user, host, sshPort] = m;
    const dest = user ? `${user}@${host}` : host;
    const sshOpts = sshPort ? ['-p', sshPort] : [];
    const rsyncSsh = sshPort ? `ssh -p ${sshPort}` : 'ssh';
    const files = readManifest(o.withSecrets);
    const master = o.master || `http://${localLanIp()}:${o.port}`;
    const nodeUrl = `http://${host}:${o.port}`;
    const vaultKey = randomBytes(32).toString('hex');
    const envContent = `TASKAND_LLM_API_KEY=\nTASKAND_LLM_MODEL=glm-5.3\nTASKAND_BIND=0.0.0.0\nTASKAND_VAULT_KEY=${vaultKey}\n`;

    const plan = [
      { label: `Preflight: docker na ${host}`, argv: ['ssh', ...sshOpts, dest, 'docker --version && docker compose version'] },
      { label: `Katalog ${o.dir}`, argv: ['ssh', ...sshOpts, dest, `mkdir -p ${o.dir}`] },
      { label: `Kopiuj ${files.length} ścieżek → ${dest}:${o.dir}/`, argv: ['rsync', '-az', '--exclude=__pycache__', '--exclude=*.pyc', '-e', rsyncSsh, ...files, `${dest}:${o.dir}/`], cwd: ROOT },
      ...(o.withSecrets ? [] : [{ label: 'Zapisz świeży .env (bind 0.0.0.0, nowy klucz sejfu; klucz LLM pusty → szablony)', argv: ['ssh', ...sshOpts, dest, `cat > ${o.dir}/.env`], input: envContent, secret: true }]),
      { label: 'Start: docker compose up -d --build', argv: ['ssh', ...sshOpts, dest, `cd ${o.dir} && docker compose up -d --build`] }
    ];
    const post = [
      `czekaj na ${nodeUrl}/healthz`,
      `taskand peer add ${nodeUrl}   (master monitoruje nowy węzeł)`,
      o.token
        ? `ssh ${dest} 'cd ${o.dir} && node bin/taskand pull ${master} ${o.token}'   (nowy węzeł pobiera pakiety mastera jako candidate)`
        : `handshake pominięty — podaj --token <token-mastera z grants.yaml>, by nowy węzeł pobrał pakiety mastera`
    ];

    if (!o.run) {
      const show = s => (s.secret ? `${s.argv.slice(0, -1).join(' ')} '…' <<'.env'` : s.argv.map(x => (/\s/.test(x) ? `'${x}'` : x)).join(' '));
      return print(
        { ok: true, mode: 'dry-run', target: dest, node: nodeUrl, dir: o.dir, files, secrets: o.withSecrets, master, handshake: !!o.token, plan: plan.map(show), post },
        () => [
          `PLAN (dry-run) — powołanie węzła ${dest} → ${nodeUrl}`,
          `  pliki (${files.length}): ${files.join(', ')}${o.withSecrets ? '  [+sekrety]' : '  (bez .env/vault — federacja i tak wymaga własnych tokenów)'}`,
          '',
          ...plan.map((s, i) => `  ${i + 1}. ${s.label}\n     $ ${show(s)}`),
          '  ── po starcie ──',
          ...post.map((p, i) => `  ${plan.length + i + 1}. ${p}`),
          '',
          'To jest operacja operatorska (SSH). Uruchom realnie:  taskand occupy ' + pos[0] + ' --run' + (o.token ? '' : ' --token <token>')
        ].join('\n')
      );
    }

    const report = [];
    for (const s of plan) {
      try {
        const out = execFileSync(s.argv[0], s.argv.slice(1), { cwd: s.cwd, input: s.input, encoding: 'utf8', stdio: s.input ? ['pipe', 'pipe', 'pipe'] : ['ignore', 'pipe', 'pipe'], timeout: 600000 });
        report.push({ step: s.label, ok: true, out: (out || '').trim().slice(0, 200) });
      } catch (err) {
        report.push({ step: s.label, ok: false, error: (err.stderr || err.message || '').toString().trim().slice(0, 400) });
        return print({ ok: false, error: `Krok nieudany: ${s.label}`, report }, r => [...r.report.map(x => `${x.ok ? '✓' : '✗'} ${x.step}${x.ok ? '' : `\n   ${x.error}`}`), `\n✗ Przerwano na: ${s.label}`].join('\n'));
      }
    }
    const health = await waitHealthz(nodeUrl);
    report.push({ step: 'healthz', ok: !!health, out: health ? `node=${health.node} procesy=${health.processes}` : 'brak odpowiedzi w 45 s' });
    const added = await reg('peer_add', { url: nodeUrl });
    report.push({ step: 'peer_add', ok: added.ok, out: (added.peers || []).join(', '), error: added.error });
    if (o.token) {
      try {
        const h = execFileSync('ssh', [...sshOpts, dest, `cd ${o.dir} && node bin/taskand pull ${master} ${o.token}`], { encoding: 'utf8', timeout: 120000 });
        report.push({ step: 'handshake pull', ok: true, out: h.trim().slice(0, 200) });
      } catch (err) { report.push({ step: 'handshake pull', ok: false, error: (err.stderr || err.message).toString().slice(0, 300) }); }
    }
    print({ ok: report.every(r => r.ok !== false), node: nodeUrl, report },
      r => [...r.report.map(x => `${x.ok === false ? '✗' : '✓'} ${x.step}${x.out ? `: ${x.out}` : ''}${x.error ? `\n   ${x.error}` : ''}`), `\n${r.ok ? '✓' : '⚠'} węzeł ${nodeUrl}`].join('\n'));
  },
  async log([n = '20']) {
    const file = join(ROOT, 'log/events.jsonl');
    console.log(existsSync(file) ? readFileSync(file, 'utf8').trim().split('\n').slice(-Number(n)).join('\n') : 'Brak zdarzeń.');
  }
};
COMMANDS.fed = COMMANDS.procs;
COMMANDS.health = COMMANDS.status;

const HELP = `taskand — organizmy wywoływane przez rejestr (URI + JSON)

  taskand "<zadanie>"              automatyczny routing przez wewnętrzny router i orkiestrator DAG
  taskand <organizm> "<zadanie>"   dev | doc | sec | hw | file | browser | admin | <dowolny powołany>
  taskand proc <uri> ['<json>']    bezpośrednie wywołanie procesu proc://
  taskand twin [run|create|status] [id]    lokalny bliźniak sieci i weryfikacja skanu URI
  taskand twin web <URL|plik.json>        bliźniak strony/API i scenariusz offline (URL = test widoczności body)
  taskand procs [organizm]         procesy w rejestrze (status, URI, opis)
  taskand approve <uri>            candidate → active (wyewoluowane / pobrane od peerów)
  taskand deprecate <uri>          wycofanie procesu
  taskand verify                   integralność pakietów (bindingHash)
  taskand pull <http://peer:8077> [token]   pobranie brakujących pakietów od węzła peer
  taskand peers                    lista węzłów peer (genome.yaml)
  taskand peer add|remove <url>    dopisz/usuń węzeł peer
  taskand occupy <user@host> [--run]        powołanie węzła na innym hoście (SSH+docker); domyślnie plan
  taskand deliver --ticket ticket-NNN      plan delivery; --pull-request enables Koru + Goal, --merge requires --wait and --key-file
  taskand status                   diagnoza usług i rejestru
  taskand heal [--plan]            samonaprawa: recepty organizmów wg policy.healing, reszta dla człowieka
  taskand log [n]                  dziennik zdarzeń (CloudEvents)
  --format <format>                format wyjściowy: json, yaml, csv, txt, table (domyślnie txt)
  --json                           skrót dla --format json

  occupy: operatorskie i jawne (nie autonomiczne). Domyślnie tylko plan; --run wymaga dostępu SSH.
    [--dir /opt/taskand] [--with-secrets] [--master http://ip:8077] [--token <token>] [--port 8077]`;

const KNOWN_ORGANISMS = new Set([
  'dev', 'admin', 'doctor', 'doc', 'hw', 'file', 'sec', 'vault', 'browser', 'twin', 'web', 'chat', 'alert'
]);

// Organizm wbudowany albo powołany później (ma procesy w rejestrze); inne pierwsze słowo należy do zadania
async function isOrganism(name) {
  if (KNOWN_ORGANISMS.has(name)) return true;
  if (!/^[a-z0-9][a-z0-9-]*$/.test(name)) return false;
  const listed = await reg('list', { organism: name });
  return Array.isArray(listed?.processes) && listed.processes.length > 0;
}

if (!cmd || cmd === 'help' || cmd === '--help') {
  console.log(HELP);
} else if (COMMANDS[cmd]) {
  await COMMANDS[cmd](args);
} else if (await isOrganism(cmd)) {
  // Jawne skierowanie do konkretnego organizmu
  const out = await chat(cmd, args.join(' ') || 'status');
  print(out, o => o.reply || `✗ ${o.error}`);
} else {
  // Uniwersalny punkt wejścia: router wewnętrzny (dev/chat) automatycznie trasuje intencję
  // do właściwego organizmu lub uruchamia orkiestrator (composite: planner -> validator -> orchestrator)
  const fullMessage = (cmd === 'run' || cmd === 'do' || cmd === 'ask' || cmd === 'task')
    ? args.join(' ')
    : [cmd, ...args].join(' ');
  if (!fullMessage.trim()) {
    console.log(HELP);
    process.exitCode = 2;
  } else {
    const out = await chat('', fullMessage);
    print(out, o => o.reply || `✗ ${o.error}`);
  }
}
